# Application Settings
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 10s
shell-integration = zsh
auto-update = download
auto-update-channel = stable

# Key Bindings Settings
keybind = ctrl+z=close_surface
keybind = ctrl+t>r=new_split:right
keybind = ctrl+t>l=new_split:left
keybind = ctrl+c=copy_to_clipboard
keybind = ctrl+p=paste_from_clipboard
keybind = ctrl+n=new_window
# Font Settings
font-family = MesloLGS NF
font-family-bold = MesloLGS NF Bold
font-family-italic = MesloLGS NF Italic
font-family-bold-italic = MesloLGS NF Bold Italic
font-size = 12

# Cursor Settings
cursor-color = #FFFFFF
cursor-opacity = 0.4
cursor-style = bar
cursor-style-blink = true

# Screen Settings
fullscreen = true
working-directory = home

# Clipboard Settings
clipboard-write = allow

# Mouse settings
right-click-action = context-menu

# Theme Settings
theme = light:GitHub,dark:Github Dark
